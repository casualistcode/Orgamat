<?xml version="1.0" encoding="utf-8"?>
<!--
  Logo im Stil von Stimmlicht: warmer Schein, in der Mitte eine leuchtende Orgeltaste
  (Form einer c-Taste von oben) mit der Nachbar-Obertaste als feiner Kontur.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Schein -->
    <path android:pathData="M24,54 A30,30 0 1 0 84,54 A30,30 0 1 0 24,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="30">
                <item android:offset="0" android:color="#4DFF8C1A" />
                <item android:offset="0.55" android:color="#1AFF8C1A" />
                <item android:offset="1" android:color="#00FF8C1A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Taste etwas größer, seit der Ring weg ist (bleibt in der sicheren Zone von 33 um die Mitte) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.25"
        android:scaleY="1.25">

        <!-- Nachbar-Obertaste als feine Kontur -->
        <path
            android:strokeColor="#8CFFAB52"
            android:strokeWidth="1.2"
            android:pathData="M56.5,34 H64.5 V54.5 Q64.5,56 63,56 H58 Q56.5,56 56.5,54.5 Z" />

        <!-- Orgeltaste (c-Taste von oben) -->
        <path android:pathData="M44,34 H55 V58 H60 V71 Q60,74 57,74 H47 Q44,74 44,71 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="52"
                    android:centerY="57"
                    android:gradientRadius="20">
                    <item android:offset="0" android:color="#FFFFE0B3" />
                    <item android:offset="0.44" android:color="#FFFFA53F" />
                    <item android:offset="1" android:color="#FFFF8514" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
